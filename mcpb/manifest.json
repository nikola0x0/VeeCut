{
  "manifest_version": "0.4",
  "name": "veecut",
  "display_name": "VeeCut",
  "version": "0.2.0",
  "description": "Edit your videos with VeeCut from Claude Desktop.",
  "long_description": "Connects Claude Desktop to the local MCP server inside VeeCut, an AI-native Mac video editor. Once installed, Claude can read your timeline, edit clips, track subjects, and manage tracks.",
  "icon": "icon.png",
  "author": {
    "name": "VeeCut",
    "url": "https://github.com/nikola0x0/VeeCut"
  },
  "homepage": "https://github.com/nikola0x0/VeeCut",
  "keywords": [
    "video",
    "editor",
    "timeline",
    "creative",
    "media"
  ],
  "compatibility": {
    "platforms": [
      "darwin"
    ],
    "runtimes": {
      "node": ">=18.0.0"
    }
  },
  "server": {
    "type": "node",
    "entry_point": "server/index.js",
    "mcp_config": {
      "command": "node",
      "args": [
        "${__dirname}/server/index.js"
      ]
    }
  }
}
